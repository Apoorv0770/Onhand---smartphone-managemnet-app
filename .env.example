# ---------------------------------------------------------------------------
# Onhand environment
# Copy this file to .env.local and fill in what you need.
# ---------------------------------------------------------------------------

# Public origin of the app. Used for metadata, share links and QR codes.
# On Vercel leave this out: the project's public address is used automatically.
# Set it there only for a custom domain, and never to a localhost address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (optional) ----------------------------------------------------
# Leave these empty to run in DEMO MODE: data is stored locally in ./.data
# (a JSON database plus uploaded images) and survives restarts.
# Set both to switch the app to Supabase (Postgres + Auth + Storage).
# See README.md > "Connecting Supabase" for the migration to run first.
# Real values belong in .env.local (ignored by git), never in this file.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key ("sb_publishable_..."). Never a secret ("sb_secret_...")
# or service_role key: the app does not need one and refuses to start with it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional safety lock: the project ref from the URL above (the part before
# ".supabase.co"). When set, the app refuses to connect to any other project.
ONHAND_SUPABASE_PROJECT_REF=

# Run `npm run supabase:check` to test this configuration. It never prints keys.

# --- Demo mode ---------------------------------------------------------------
# Password for the three seeded demo retailer accounts (demo mode only).
# Applied when the demo database is first created; run `npm run demo:reset`
# after changing it. Falls back to the value documented in README.md.
DEMO_PASSWORD=

# Where demo mode keeps its database and uploads. Defaults to ./.data
ONHAND_DATA_DIR=
